{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "incremental": false,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "lib": ["ES2024"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["koans", "solutions", "checks", "traces", "support", "verify"],
  "exclude": ["verify/fixtures/**", "_variants/**"]
}
